---
import "../styles/global.css";
import { LEGAL } from "../legal";

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;700&display=swap"
		/>
		<meta name="description" content={`${title} de ${LEGAL.marca}.`} />
		<title>{title} — {LEGAL.marca}</title>
	</head>
	<body class="bg-slate-950 text-slate-100">
		<header class="border-b border-white/10">
			<nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
				<a href="/" class="text-lg font-semibold" style="font-family: 'Space Grotesk', sans-serif;">
					{LEGAL.marca}
				</a>
				<a href="/" class="text-sm text-slate-300 hover:text-white">Volver al inicio</a>
			</nav>
		</header>
		<main
			class="legal mx-auto max-w-3xl px-6 py-16 text-slate-200 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-white [&_p]:mt-3 [&_p]:leading-relaxed [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6 [&_a]:text-cyan-200 [&_a:hover]:text-white"
		>
			<h1 class="text-3xl font-semibold text-white md:text-4xl" style="font-family: 'Fraunces', serif;">{title}</h1>
			<p class="text-sm text-slate-400">Última actualización: {LEGAL.actualizado}</p>
			<slot />
		</main>
		<footer class="border-t border-white/10">
			<div class="mx-auto max-w-3xl px-6 py-10 text-sm text-slate-400">
				{LEGAL.marca} — {LEGAL.titular}, CUIT {LEGAL.cuit}. {LEGAL.ciudad}.
				<span class="mx-2">·</span><a class="hover:text-white" href="/privacidad">Privacidad</a>
				<span class="mx-2">·</span><a class="hover:text-white" href="/terminos">Términos</a>
			</div>
		</footer>
	</body>
</html>
